# Copy to .dev.vars (for `wrangler dev`) or export in your shell (for scripts). Never commit real values.
# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# mock | sandbox   (mock needs no keys; sandbox calls api-m.sandbox.paypal.com)
PAYPAL_MODE=mock
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID from the sandbox app's webhook settings (used to verify webhook signatures in sandbox mode)
PAYPAL_WEBHOOK_ID=
# Shared secret accepted on the x-mock-signature header for webhooks in mock mode
MOCK_WEBHOOK_SECRET=local-dev-only
# Bearer token for merchant APIs (dashboard, approvals, ops agent)
MERCHANT_TOKEN=change-me-local
# true = merchant APIs open without token (hosted judge demo, sandbox only)
DEMO_MODE=false
# Public base URL used to build PayPal return/cancel URLs
PUBLIC_BASE_URL=http://localhost:8787
# stub | openai   (stub = deterministic, no key, no spend)
LLM_MODE=stub
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# AG Studio licence key (optional; without it Studio runs with a watermark locally)
VITE_AG_STUDIO_LICENSE_KEY=
# Vault id of a pre-approved sandbox buyer mandate the simulator may charge (created by scripts/sandbox-go-no-go.mjs)
SIM_VAULT_ID=
# Optional: sandbox personal (buyer) login, only for the automated approval mode of the go/no-go script
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
